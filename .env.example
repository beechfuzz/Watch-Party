# Copy this file to .env and fill in real values. Never commit the real
# .env file — it holds secrets. See README.md for full setup instructions.

# --- Server ---

# Address the HTTP server listens on.
LISTEN_ADDR=:8080

# Comma-separated list of origins this deployment is served from. Used for
# WebSocket Origin validation (rejects cross-origin WS connection attempts)
# and for reasoning about cookie security. Must match exactly what users'
# browsers see, scheme included (e.g. https://watchparty.example.com).
APP_ORIGINS=https://watchparty.example.com

# Set to "true" only for local development to permit non-Secure session
# cookies over plain http:// (e.g. testing from http://192.168.x.x:8080).
# Never enable this in production — the Secure cookie attribute is
# mandatory there and this flag is the only way to relax it.
DEV_MODE=false

# --- Emby ---

# Base URL of your Emby server, reachable from the Watch Party container.
EMBY_SERVER_URL=https://emby.example.com

# --- Persistence ---

# Path to the SQLite database file. The directory is created if missing.
DATABASE_PATH=./data/watchparty.db

# --- Security ---

# 32-byte key (base64 or hex encoded) used to encrypt Emby AccessTokens at
# rest with AES-256-GCM. Generate one with:
#   openssl rand -base64 32
# or:
#   ./watchparty --generate-key
# Rotating this key invalidates every stored token (users must sign in
# again) — there is no key-rotation migration, by design, since a 32-byte
# secret is trivial to regenerate and re-authenticating is a one-click
# Emby login, not a data-loss event.
TOKEN_ENCRYPTION_KEY=

# Sliding idle timeout: a session with no activity for this long is
# invalidated. Accepts a bare integer (seconds) or a Go duration string
# (e.g. "24h", "30m").
SESSION_IDLE_TIMEOUT=24h

# Absolute maximum session age, regardless of activity.
SESSION_MAX_AGE=720h

# --- Party lifecycle ---

# How long a disconnected host has to reconnect before host authority
# transfers to the longest-waiting connected participant. Accepts a bare
# integer (seconds) or a Go duration string.
HOST_GRACE_PERIOD_SECONDS=20

# --- Synchronization tuning ---

# How often the server broadcasts a full authoritative snapshot to every
# participant, independent of event-driven play/pause/seek broadcasts.
SYNC_SNAPSHOT_INTERVAL=4s

# Drift below this threshold (milliseconds) is left uncorrected.
SYNC_SOFT_DRIFT_MS=300

# Drift above this threshold (milliseconds) triggers a hard seek instead of
# a gradual playback-rate correction. Must be greater than SYNC_SOFT_DRIFT_MS.
SYNC_HARD_DRIFT_MS=1500

# Maximum fractional playback-rate adjustment used for gradual drift
# correction, e.g. 0.05 allows a rate range of [0.95, 1.05].
SYNC_MAX_RATE_ADJUSTMENT=0.05

# --- Emby playback reporting ---

# How often each connected participant's playback progress is reported back
# to their own Emby account (Sessions/Playing/Progress), independent of the
# WebSocket sync cadence.
EMBY_PROGRESS_INTERVAL=10s

# --- Logging ---

# One of: debug, info, warn, error. At debug level, per-event sync
# diagnostics are logged (party/user/sequence/position/drift/RTT/offset) —
# never credentials, tokens, session IDs, or playback URLs, even at this
# level.
LOG_LEVEL=info
