# Copy this file to .env and fill in real values. Never commit the real
# .env file — it holds secrets. See README.md for full setup instructions
# and a complete table of every recognized environment variable and its
# default.

# --- Server ---

# Address the HTTP server listens on. (default: :8080)
LISTEN_ADDR=:8080

# Comma-separated list of origins this deployment is served from. Used for
# WebSocket Origin validation (rejects cross-origin WS connection attempts).
# Must match exactly what users' browsers see, scheme included. Mixing
# schemes is fine — e.g. an external HTTPS domain alongside an
# internal-only HTTP LAN hostname for the same instance — the session
# cookie's Secure attribute is set per-request to match what each request
# actually arrived over (via X-Forwarded-Proto, trusting the reverse proxy
# this app is designed to run behind — see README.md and ARCHITECTURE.md),
# not from a single global flag. Required — no default.
APP_ORIGINS=https://watchparty.example.com,http://watchparty.home

# --- Emby ---

# Base URL of your Emby server, reachable from the Watch Party container.
# Required — no default.
EMBY_SERVER_URL=https://emby.example.com

# --- Container user (podman run / podman quadlet / docker run) ---

# UID/GID the server process runs as. Only takes effect when the container
# is started as root (the image's default — see README.md and
# ARCHITECTURE.md for why): the server takes ownership of its data
# directory and permanently drops to PUID:PGID before doing anything else.
# Has no effect if you override the image's user to something non-root
# yourself (e.g. `podman run --user`), since privilege-dropping requires
# starting as root in the first place. (default: 65532, both)
PUID=65532
PGID=65532

# --- Persistence ---

# Path to the SQLite database file. The directory is created (and, if
# running as root, chowned to PUID:PGID) if missing. Defaults to the
# container's conventional volume mount point — see docker-compose.yml and
# watchparty.container, both of which mount a persistent volume at /data.
# For local `go run` development, point this somewhere writable instead,
# e.g. ./data/watchparty.db. (default: /data/watchparty.db)
DATABASE_PATH=/data/watchparty.db

# --- Security ---

# 32-byte key (base64 or hex encoded) used to encrypt Emby AccessTokens at
# rest with AES-256-GCM. Generate one with:
#   openssl rand -base64 32
# or:
#   ./watchparty --generate-key
# Rotating this key invalidates every stored token (users must sign in
# again) — there is no key-rotation migration, by design, since a 32-byte
# secret is trivial to regenerate and re-authenticating is a one-click
# Emby login, not a data-loss event. Required — no default.
TOKEN_ENCRYPTION_KEY=

# Sliding idle timeout: a session with no activity for this long is
# invalidated. Accepts a bare integer (seconds) or a Go duration string
# (e.g. "24h", "30m"). (default: 24h)
SESSION_IDLE_TIMEOUT=24h

# Absolute maximum session age, regardless of activity. (default: 720h, i.e. 30 days)
SESSION_MAX_AGE=720h

# --- Party lifecycle ---

# How long a disconnected host has to reconnect before host authority
# transfers to the longest-waiting connected participant. Accepts a bare
# integer (seconds) or a Go duration string. (default: 20, i.e. 20s)
HOST_GRACE_PERIOD_SECONDS=20

# --- Synchronization tuning ---

# How often the server broadcasts a full authoritative snapshot to every
# participant, independent of event-driven play/pause/seek broadcasts.
# (default: 4s)
SYNC_SNAPSHOT_INTERVAL=4s

# Drift below this threshold (milliseconds) is left uncorrected. (default: 300)
SYNC_SOFT_DRIFT_MS=300

# Drift above this threshold (milliseconds) triggers a hard seek instead of
# a gradual playback-rate correction. Must be greater than
# SYNC_SOFT_DRIFT_MS. (default: 1500)
SYNC_HARD_DRIFT_MS=1500

# Maximum fractional playback-rate adjustment used for gradual drift
# correction, e.g. 0.05 allows a rate range of [0.95, 1.05]. (default: 0.05)
SYNC_MAX_RATE_ADJUSTMENT=0.05

# --- Emby playback reporting ---

# How often each connected participant's playback progress is reported back
# to their own Emby account (Sessions/Playing/Progress), independent of the
# WebSocket sync cadence. (default: 10s)
EMBY_PROGRESS_INTERVAL=10s

# --- Logging ---

# One of: debug, info, warn, error. At debug level, per-event sync
# diagnostics are logged (party/user/sequence/position/drift/RTT/offset) —
# never credentials, tokens, session IDs, or playback URLs, even at this
# level. (default: info)
LOG_LEVEL=info
