// Generated by the Watch Party setup wizard. Safe to hand-edit afterward --
// this file is only ever read at process startup (see internal/config),
// never rewritten automatically.
//
// TOKEN_ENCRYPTION_KEY / TOKEN_ENCRYPTION_KEY_FILE are never read from this
// file, only from the environment -- see README.md and ARCHITECTURE.md §16
// for why. The wizard displayed a generated key once, in the setup form;
// if you haven't set it yet, the server will wait for you to set one of
// those two environment variables and restart before it can serve normal
// traffic.
{
  "server_settings": {
    // Site title shown in the page <title> and the sidebar.
    "title": {{.Title | jsonString}},
    // One of "debug", "info", "warn", "error".
    "log_level": {{.LogLevel | jsonString}},
    // Origins this app is served from. Enforced on WebSocket connections.
    "browser_origins": [{{range $i, $o := .BrowserOrigins}}{{if $i}}, {{end}}{{$o | jsonString}}{{end}}],
    // Address the HTTP server listens on.
    "listen_address": {{.ListenAddress | jsonString}},
    // Sliding idle timeout -- a session with no activity this long is invalidated.
    "session_idle_timeout": {{.SessionIdleTimeout | jsonString}},
    // Absolute maximum session age, regardless of activity.
    "session_age_timeout": {{.SessionAgeTimeout | jsonString}}
  },
  "global_party_settings": {
    // How long a disconnected host has to reconnect before host status transfers.
    "host_grace_period": {{.HostGracePeriod | jsonString}},
    // How long a party can go with no playback control and no one
    // connecting/reconnecting before it's automatically ended.
    "inactivity_timeout": {{.InactivityTimeout | jsonString}}
  },
  "global_playback_settings": {
    // How often each participant's watch progress is reported to their own Emby account.
    "progress_interval": {{.ProgressInterval | jsonString}},
    // How often the server broadcasts a full authoritative snapshot to every participant.
    "sync_snapshot_interval": {{.SyncSnapshotInterval | jsonString}},
    // Drift below this is left uncorrected. Must carry an explicit unit (e.g. "300ms").
    "sync_soft_drift": {{.SyncSoftDrift | jsonString}},
    // Drift above this triggers a hard seek instead of a gradual rate nudge.
    // Must be greater than sync_soft_drift and carry an explicit unit.
    "sync_hard_drift": {{.SyncHardDrift | jsonString}},
    // Max fractional playback-rate nudge for gradual drift correction
    // (0.05 => rate range [0.95, 1.05]). Must be between 0 and 1, exclusive.
    "sync_max_rate_adjustment": {{.SyncMaxRateAdjustment}}
  },
  "media_server_settings": {
    // Your Emby server's base URL, reachable from the Watch Party container/process itself.
    "server_url": {{.ServerURL | jsonString}},
    // Emby's base URL as reached by a participant's browser, if different
    // from server_url. Leave blank to default to server_url.
    "public_url": {{.PublicURL | jsonString}}
  }
}
